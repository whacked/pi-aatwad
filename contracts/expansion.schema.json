{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpansionProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "requester_id",
    "task_id",
    "reason",
    "roles",
    "estimated_cost_usd",
    "alternatives"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "requester_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 12
    },
    "alternatives": {
      "type": "string",
      "minLength": 1
    },
    "estimated_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "max_runtime_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "responsibility",
          "count",
          "capabilities"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred_model_id": {
            "type": "string"
          },
          "max_cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "max_runtime_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
